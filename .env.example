POSTGRES_PASSWORD=changeme
ANTHROPIC_API_KEY=sk-ant-...

# Generate your own: openssl rand -hex 32
# This authenticates the gbrain /admin dashboard and bootstraps OAuth client
# registration. It is NOT the token cos uses day-to-day — mint that
# separately after the stack is up:
#   docker compose exec gbrain-shared gbrain auth create cos
GBRAIN_ADMIN_BOOTSTRAP_TOKEN=changeme-generate-with-openssl-rand-hex-32
